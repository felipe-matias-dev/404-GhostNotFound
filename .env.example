# Copie para .env na raiz (cp .env.example .env). Lido pelo docker compose.
# Senhas só para o banco local de desenvolvimento. Use só letras, números e hífen: a senha
# entra na URL de conexão da API (VENERGY_API_DATABASE_URL), onde @ : / # quebram o endereço.

POSTGRES_PASSWORD=troque-esta-senha
# Usuário somente leitura usado pelo agente de IA.
AGENT_DB_PASSWORD=troque-esta-senha-do-agente
# Porta do banco na sua máquina.
POSTGRES_PORT=5433
# Portas da API e do portal na sua máquina (docker compose up).
API_PORT=8000
WEB_PORT=3000
# Chave do Gemini do agente de IA, uma por pessoa (aistudio.google.com). Sem ela a API sobe
# normalmente, mas o /ai responde 503.
GOOGLE_API_KEY=
# Modelos reserva do agente na API, em ordem (padrão do compose: google-gla:gemini-3.5-flash).
# Com a chave do OpenRouter, a cadeia pode seguir para outro provedor, se o Gemini inteiro cair:
# GEMINI_FALLBACK_MODEL=google-gla:gemini-3.5-flash,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-31b-it:free
# Chave do OpenRouter (openrouter.ai/keys), só se a cadeia acima tiver modelos openrouter:
# OPENROUTER_API_KEY=

# Segredo que assina o token de sessão do login. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-do-token-de-sessao-local

# Senha dos 5 usuários de demonstração do portal (henrique, camila, rafael, beatriz, patricia).
# Só para rodar localmente; o comando `make users` aplica esta senha.
SENHA_DEMO=venergy-demo-2026

# Traces do OpenTelemetry (DEC-068), opcional. Para ver cada requisição no Jaeger, preencha com
# http://jaeger:4318/v1/traces e suba com: docker compose --profile observabilidade up -d --wait
# Vazio, a API não envia nada.
RASTREAMENTO_ENDPOINT=
# Porta da interface do Jaeger na sua máquina.
JAEGER_PORT=16686
