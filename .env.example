# Copie para .env na raiz (cp .env.example .env). Lido pelo docker compose.
# Senhas só para o banco local de desenvolvimento. Use só letras, números e hífen: a senha
# entra na URL de conexão da API (VENERGY_API_DATABASE_URL), onde @ : / # quebram o endereço.

POSTGRES_PASSWORD=troque-esta-senha
# Usuário somente leitura usado pelo agente de IA.
AGENT_DB_PASSWORD=troque-esta-senha-do-agente
# Porta do banco na sua máquina.
POSTGRES_PORT=5433
# Portas da API e do portal na sua máquina (docker compose up).
API_PORT=8000
WEB_PORT=3000
# Chave do Gemini do agente de IA, uma por pessoa (aistudio.google.com). Opcional até o /ai existir.
GOOGLE_API_KEY=
