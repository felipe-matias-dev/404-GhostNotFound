# Copie para ai-agent/.env (cp .env.example .env). O .env não vai para o Git.

# Gemini direto (padrão): chave gratuita do Google AI Studio, uma por pessoa.
VENERGY_AGENT_LLM_MODEL=google-gla:gemini-3.1-flash-lite
VENERGY_AGENT_GOOGLE_API_KEY=troque-pela-sua-chave
# Modelos reserva, em ordem: entram se o anterior falhar (429 ou 503) depois das retentativas; a cota
# do plano gratuito é por modelo. Lista separada por vírgula; nenhum pode ser igual ao JUDGE_MODEL.
# Modelos openrouter: exigem a VENERGY_AGENT_OPENROUTER_API_KEY.
# VENERGY_AGENT_FALLBACK_MODEL=google-gla:gemini-3.5-flash,openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:google/gemma-4-31b-it:free

# Alternativa pelo OpenRouter (modelos ":free" têm limite de 50 requisições por dia por conta):
# VENERGY_AGENT_LLM_MODEL=openrouter:google/gemma-4-31b-it:free
# VENERGY_AGENT_OPENROUTER_API_KEY=troque-pela-sua-chave

# Usuário somente leitura do agente (ver infra/postgres/init). Porta 5433 é a padrão do docker compose.
VENERGY_AGENT_DATABASE_URL=postgresql://venergy_agent:troque-esta-senha-do-agente@127.0.0.1:5433/venergy

# Avaliação: modelo do juiz (só para `--judge`, diferente do LLM_MODEL):
VENERGY_AGENT_JUDGE_MODEL=google-gla:gemini-3.5-flash-lite
