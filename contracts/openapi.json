{
  "openapi": "3.1.0",
  "info": {
    "title": "V-Energy Grid 360 API",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "saúde"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/unidades-consumidoras/{cod_uc}": {
      "get": {
        "tags": [
          "unidades consumidoras"
        ],
        "summary": "Get Unidade Consumidora",
        "operationId": "get_unidade_consumidora_unidades_consumidoras__cod_uc__get",
        "parameters": [
          {
            "name": "cod_uc",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cod Uc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DimUcSchema"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/receita/mensal": {
      "get": {
        "tags": [
          "receita"
        ],
        "summary": "Get Receita Mensal",
        "description": "Indicadores de cada competência do período, do mês mais antigo ao mais recente.",
        "operationId": "get_receita_mensal_receita_mensal_get",
        "parameters": [
          {
            "name": "inicio",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Inicio"
            }
          },
          {
            "name": "fim",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fim"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KpisMensaisSchema"
                  },
                  "title": "Response Get Receita Mensal Receita Mensal Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ordens-inspecao": {
      "post": {
        "tags": [
          "ordens de inspeção"
        ],
        "summary": "Criar Ordens",
        "description": "Gera uma OI por UC, tudo ou nada: se uma UC falhar, nenhuma OI é criada.",
        "operationId": "criar_ordens_ordens_inspecao_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarOrdensSchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdemSchema"
                  },
                  "title": "Response Criar Ordens Ordens Inspecao Post"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "ordens de inspeção"
        ],
        "summary": "Listar Ordens",
        "description": "Lista as OIs, das mais recentes para as mais antigas, opcionalmente por status.",
        "operationId": "listar_ordens_ordens_inspecao_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StatusOrdem"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdemSchema"
                  },
                  "title": "Response Listar Ordens Ordens Inspecao Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ordens-inspecao/{ordem_id}": {
      "get": {
        "tags": [
          "ordens de inspeção"
        ],
        "summary": "Obter Ordem",
        "operationId": "obter_ordem_ordens_inspecao__ordem_id__get",
        "parameters": [
          {
            "name": "ordem_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Ordem Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDetalheSchema"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "ordens de inspeção"
        ],
        "summary": "Atualizar Ordem",
        "description": "Muda o status da OI (inclusive cancelar) e registra a mudança no histórico.",
        "operationId": "atualizar_ordem_ordens_inspecao__ordem_id__patch",
        "parameters": [
          {
            "name": "ordem_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Ordem Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarOrdemSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDetalheSchema"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroSchema"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AtualizarOrdemSchema": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusOrdem"
          },
          "resultado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultadoOrdem"
              },
              {
                "type": "null"
              }
            ]
          },
          "observacao": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacao"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AtualizarOrdemSchema",
        "description": "Mudança de status de uma OI. Cancelar é mudar para CANCELADA."
      },
      "CriarOrdensSchema": {
        "properties": {
          "cod_ucs": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Cod Ucs"
          }
        },
        "type": "object",
        "required": [
          "cod_ucs"
        ],
        "title": "CriarOrdensSchema",
        "description": "UCs escolhidas na fila de suspeitas; gera uma OI para cada uma."
      },
      "DimUcSchema": {
        "properties": {
          "cod_uc": {
            "type": "string",
            "minLength": 1,
            "title": "Cod Uc"
          },
          "municipio": {
            "type": "string",
            "minLength": 1,
            "title": "Municipio"
          },
          "bairro": {
            "type": "string",
            "minLength": 1,
            "title": "Bairro"
          },
          "classe": {
            "type": "string",
            "enum": [
              "B1",
              "B2",
              "B3",
              "A4"
            ],
            "title": "Classe"
          },
          "cod_alimentador": {
            "type": "string",
            "minLength": 1,
            "title": "Cod Alimentador"
          },
          "possui_gd": {
            "type": "boolean",
            "title": "Possui Gd"
          },
          "consumo_medio_kwh_12m": {
            "type": "number",
            "title": "Consumo Medio Kwh 12M"
          },
          "cod_cliente": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Cod Cliente"
          },
          "subgrupo": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Subgrupo"
          },
          "potencia_kw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Potencia Kw"
          }
        },
        "type": "object",
        "required": [
          "cod_uc",
          "municipio",
          "bairro",
          "classe",
          "cod_alimentador",
          "possui_gd",
          "consumo_medio_kwh_12m",
          "cod_cliente",
          "subgrupo",
          "potencia_kw"
        ],
        "title": "DimUcSchema"
      },
      "ErroSchema": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErroSchema",
        "description": "Corpo das respostas de erro do FastAPI (HTTPException), documentado no OpenAPI."
      },
      "EventoSchema": {
        "properties": {
          "status_anterior": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StatusOrdem"
              },
              {
                "type": "null"
              }
            ]
          },
          "status_novo": {
            "$ref": "#/components/schemas/StatusOrdem"
          },
          "observacao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacao"
          },
          "ocorrido_em": {
            "type": "string",
            "format": "date-time",
            "title": "Ocorrido Em"
          }
        },
        "type": "object",
        "required": [
          "status_anterior",
          "status_novo",
          "observacao",
          "ocorrido_em"
        ],
        "title": "EventoSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KpisMensaisSchema": {
        "properties": {
          "competencia": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Competencia"
          },
          "kwh_faturado": {
            "type": "number",
            "title": "Kwh Faturado"
          },
          "receita_faturada": {
            "type": "number",
            "title": "Receita Faturada"
          },
          "dec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dec"
          },
          "fec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fec"
          },
          "n_chamados": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N Chamados"
          },
          "satisfacao_media": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Satisfacao Media"
          }
        },
        "type": "object",
        "required": [
          "competencia",
          "kwh_faturado",
          "receita_faturada",
          "dec",
          "fec",
          "n_chamados",
          "satisfacao_media"
        ],
        "title": "KpisMensaisSchema",
        "description": "Indicadores executivos de uma competência."
      },
      "OrdemDetalheSchema": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "cod_uc": {
            "type": "string",
            "title": "Cod Uc"
          },
          "status": {
            "$ref": "#/components/schemas/StatusOrdem"
          },
          "resultado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultadoOrdem"
              },
              {
                "type": "null"
              }
            ]
          },
          "observacao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacao"
          },
          "criada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Criada Em"
          },
          "atualizada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Atualizada Em"
          },
          "eventos": {
            "items": {
              "$ref": "#/components/schemas/EventoSchema"
            },
            "type": "array",
            "title": "Eventos"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cod_uc",
          "status",
          "resultado",
          "observacao",
          "criada_em",
          "atualizada_em",
          "eventos"
        ],
        "title": "OrdemDetalheSchema",
        "description": "A OI com o histórico de mudanças de status, do mais antigo ao mais recente."
      },
      "OrdemSchema": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "cod_uc": {
            "type": "string",
            "title": "Cod Uc"
          },
          "status": {
            "$ref": "#/components/schemas/StatusOrdem"
          },
          "resultado": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultadoOrdem"
              },
              {
                "type": "null"
              }
            ]
          },
          "observacao": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacao"
          },
          "criada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Criada Em"
          },
          "atualizada_em": {
            "type": "string",
            "format": "date-time",
            "title": "Atualizada Em"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cod_uc",
          "status",
          "resultado",
          "observacao",
          "criada_em",
          "atualizada_em"
        ],
        "title": "OrdemSchema"
      },
      "ResultadoOrdem": {
        "type": "string",
        "enum": [
          "IRREGULAR_CONFIRMADA",
          "REGULAR",
          "NAO_REALIZADA"
        ],
        "title": "ResultadoOrdem"
      },
      "StatusOrdem": {
        "type": "string",
        "enum": [
          "GERADA",
          "EM_CAMPO",
          "CONCLUIDA",
          "CANCELADA"
        ],
        "title": "StatusOrdem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
