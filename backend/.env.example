# Copie para .env (cp .env.example .env) e ajuste se necessário.

# Caminho relativo à pasta backend/, de onde a API é executada.
# O banco fica em data/, na raiz do repositório, compartilhado com o agente de IA.
VENERGY_API_DATABASE_URL=sqlite:///../data/venergy.db

# Pasta com os CSVs da Gold (um arquivo por tabela), lida por: uv run python -m venergy_api.carga
VENERGY_API_GOLD_DIR=../data/gold
