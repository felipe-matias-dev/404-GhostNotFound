# Copie para .env (cp .env.example .env) e ajuste se necessário.

# Banco PostgreSQL do docker compose (raiz do repositório). Usuário, senha e porta
# devem bater com o .env da raiz.
VENERGY_API_DATABASE_URL=postgresql+psycopg://venergy:troque-esta-senha@127.0.0.1:5433/venergy

# Pasta com os CSVs da Gold (um arquivo por tabela), lida por: uv run python -m venergy_api.carga
# Caminho relativo à pasta backend/, de onde os comandos rodam.
VENERGY_API_GOLD_DIR=../data/gold

# Endereços do frontend autorizados a chamar a API pelo navegador (lista em JSON).
VENERGY_API_CORS_ORIGINS=["http://localhost:3000"]

# Limite de perguntas por usuário logado no POST /ai/ask, em todas as sessões dele: máximo por janela, em segundos (429 ao passar).
# 0 em VENERGY_API_AI_LIMITE_PERGUNTAS desliga o limite.
# VENERGY_API_AI_LIMITE_PERGUNTAS=20
# VENERGY_API_AI_JANELA_SEGUNDOS=600
# Janela do orçamento de tokens do agente por usuário, em segundos (padrão: 24 horas).
# VENERGY_API_AI_JANELA_ORCAMENTO_SEGUNDOS=86400

# Assina o token de sessão do login (DEC-049). Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# O valor de exemplo serve só para rodar localmente: quem expõe a API troca por um gerado.
VENERGY_API_JWT_SECRET=troque-este-segredo-do-token-de-sessao-local

# Senha dos usuários de demonstração, criados por: uv run python -m venergy_api.usuarios
# A mesma para todos; serve só para rodar o portal localmente.
VENERGY_API_SENHA_DEMO=venergy-demo-2026
