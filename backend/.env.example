# Copie para .env (cp .env.example .env) e ajuste se necessário.

# Banco PostgreSQL do docker compose (raiz do repositório). Usuário, senha e porta
# devem bater com o .env da raiz.
VENERGY_API_DATABASE_URL=postgresql+psycopg://venergy:troque-esta-senha@127.0.0.1:5433/venergy

# Pasta com os CSVs da Gold (um arquivo por tabela), lida por: uv run python -m venergy_api.carga
# Caminho relativo à pasta backend/, de onde os comandos rodam.
VENERGY_API_GOLD_DIR=../data/gold

# Endereços do frontend autorizados a chamar a API pelo navegador (lista em JSON).
VENERGY_API_CORS_ORIGINS=["http://localhost:5173"]
