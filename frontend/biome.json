{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/.storybook/**/*.ts",
			"**/index.html",
			"**/vite.config.ts",
			"**/vitest.config.ts",
			"!**/storybook-static",
			"!**/src/**/*.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"domains": { "react": "recommended", "test": "none" }
	},
	"overrides": [
		{
			"includes": ["**/__tests__/**"],
			"linter": { "domains": { "test": "recommended" } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
