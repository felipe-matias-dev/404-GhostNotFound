# Copie para .env.local e ajuste quando o backend estiver definido.

# Base usada pelo navegador para chamar o FastAPI.
# Dev: mantenha /api (o proxy do Vite encaminha para API_PROXY_TARGET).
# Fora do dev: URL completa do FastAPI, ex.: https://api.exemplo.com
VITE_API_URL=/api

# Só em dev: para onde o proxy /api do Vite encaminha (o prefixo /api é removido).
API_PROXY_TARGET=http://localhost:8000
